import React, { useEffect, useState } from 'react';
import { View, StyleSheet, ScrollView, ActivityIndicator } from 'react-native';
import { Title, Paragraph, Text, Card, Button } from 'react-native-paper';
import { getProductDetails } from '../services/api';

export default function ProductDetailScreen({ route, navigation }) {
  const { productId } = route.params;
  const [product, setProduct] = useState(null);
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    getProductDetails(productId)
      .then(response => {
        setProduct(response.data);
        setLoading(false);
      })
      .catch(error => {
        console.error(error);
        setLoading(false);
      });
  }, [productId]);

  if (loading) {
    return <ActivityIndicator style={styles.loader} size="large" color="#6200ee" />;
  }

  return (
    <ScrollView style={styles.container}>
      <Card>
        <Card.Cover source={{ uri: product.thumbnail }} />
        <Card.Content>
          <Title style={styles.title}>{product.title}</Title>
          <View style={styles.priceTag}>
            <Text style={styles.price}>R$ {product.price}</Text>
            <Text style={styles.discount}>-{product.discountPercentage}% OFF</Text>
          </View>
          <Paragraph style={styles.description}>{product.description}</Paragraph>
          
          <Button 
            mode="contained" 
            onPress={() => navigation.goBack()} 
            style={styles.button}
          >
            Voltar para a lista
          </Button>
        </Card.Content>
      </Card>
    </ScrollView>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, backgroundColor: '#fff' },
  loader: { flex: 1, justifyContent: 'center' },
  title: { fontSize: 24, marginTop: 15 },
  priceTag: { flexDirection: 'row', alignItems: 'center', marginVertical: 10 },
  price: { fontSize: 20, fontWeight: 'bold', color: '#6200ee' },
  discount: { marginLeft: 10, color: 'green', fontWeight: 'bold' },
  description: { fontSize: 16, marginVertical: 15, lineHeight: 22 },
  button: { marginTop: 20, marginBottom: 40 }
});