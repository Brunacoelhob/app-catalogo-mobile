import React from 'react';
import { createBottomTabNavigator } from '@react-navigation/bottom-tabs';
import { MaterialCommunityIcons } from '@expo/vector-icons';
import { Button } from 'react-native-paper';
import { useDispatch } from 'react-redux';
import { logout } from '../store/authSlice';
import ProductListScreen from './ProductListScreen';

const Tab = createBottomTabNavigator();

export default function HomeScreen() {
  const dispatch = useDispatch();

  return (
    <Tab.Navigator
      screenOptions={{
        tabBarActiveTintColor: '#6200ee',
        headerRight: () => (
          <Button onPress={() => dispatch(logout())} color="red">Sair</Button>
        ),
      }}
    >
      <Tab.Screen 
        name="Masculino" 
        component={ProductListScreen} 
        initialParams={{ category: 'mens-shirts' }} // Categoria da API
        options={{
          tabBarIcon: ({ color }) => <MaterialCommunityIcons name="account" color={color} size={26} />,
        }}
      />
      <Tab.Screen 
        name="Feminino" 
        component={ProductListScreen} 
        initialParams={{ category: 'womens-dresses' }} // Outra categoria da API
        options={{
          tabBarIcon: ({ color }) => <MaterialCommunityIcons name="account-outline" color={color} size={26} />,
        }}
      />
    </Tab.Navigator>
  );
}